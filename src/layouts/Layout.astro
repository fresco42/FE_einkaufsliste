---
import AuthNav from "../components/AuthNav.svelte";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Einkaufsliste</title>
  </head>
  <body>
    <header>
      <div class="header-content">
        <a href="/lists" class="logo">Einkaufsliste</a>
        <AuthNav client:load />
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  header {
    background-color: var(--primary);
    color: white;
    padding: 1rem;
  }

  .header-content {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: white;
    font-weight: 600;
    font-size: 1.25rem;
  }

  .logo:hover {
    opacity: 0.9;
  }
</style>
